NCPC_DATABASE_URL=postgresql+psycopg://ncpc:ncpc@postgres:5432/ncpc
NCPC_ENVIRONMENT=development
NCPC_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-secret
NCPC_ADMIN_BOOTSTRAP_CLIENT_ID=bootstrap-admin
NCPC_CORS_ORIGINS=[]
NCPC_LOG_LEVEL=INFO
NCPC_MAX_REQUEST_BYTES=1048576
NCPC_RATE_LIMIT_PER_MINUTE=120
